{
    "name": "laya-http-client",
    "version": "0.2.0",
    "description": "Typed HTTP client for the official Laya System 1 HTTP server (laya-serve / POST /v1/systemone).",
    "author": "Angel S. Moreno <angelxmoreno@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/angelxmoreno/laya-http-client.git"
    },
    "bugs": {
        "url": "https://github.com/angelxmoreno/laya-http-client/issues"
    },
    "homepage": "https://github.com/angelxmoreno/laya-http-client#readme",
    "keywords": [
        "laya",
        "system-1",
        "decision-model",
        "laya-serve",
        "http-client",
        "typescript",
        "zod"
    ],
    "type": "module",
    "module": "src/index.ts",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "src",
        "README.md"
    ],
    "engines": {
        "bun": ">=1.2"
    },
    "packageManager": "bun@1.3.14",
    "scripts": {
        "prepare": "lefthook install",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "test": "bun test",
        "check:types": "tsc",
        "check:dead-code": "bun run fallow dead-code",
        "check:dupes": "bun run fallow dupes",
        "check:health": "bun run fallow health",
        "check:audit": "bun run fallow audit",
        "prepublishOnly": "bun run test && bun run check:types"
    },
    "dependencies": {
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@types/bun": "^1.4.2",
        "fallow": "^3.29.0",
        "lefthook": "^2.1.14",
        "typescript": "^7.0.2"
    }
}
